{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metesec.com/schemas/detection-catalogue-v1.schema.json",
  "title": "MeteSec generated detection catalogue v1",
  "description": "Deterministic discovery index generated from detection manifests, fixture indexes, and explicit target profiles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "summary", "detections"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "const": "catalog/detections/*/manifest.json" },
    "summary": { "$ref": "#/$defs/summary" },
    "detections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/detection" }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detections", "implementations", "positive_cases", "negative_cases", "sentinel_preview_bindings"],
      "properties": {
        "detections": { "type": "integer", "minimum": 1 },
        "implementations": { "type": "integer", "minimum": 0 },
        "positive_cases": { "type": "integer", "minimum": 0 },
        "negative_cases": { "type": "integer", "minimum": 0 },
        "sentinel_preview_bindings": { "type": "integer", "minimum": 0 }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "lifecycle", "severity", "confidence", "attack", "data_sources", "validation", "implementations", "target_bindings", "manifest"],
      "properties": {
        "id": { "type": "string", "pattern": "^MSEC-DET-[0-9]{4}$" },
        "title": { "type": "string", "minLength": 8 },
        "description": { "type": "string", "minLength": 20 },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "severity": { "enum": ["informational", "low", "medium", "high", "critical"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "attack": { "type": "array", "items": { "$ref": "#/$defs/attack" } },
        "data_sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/data_source" } },
        "validation": { "$ref": "#/$defs/validation" },
        "implementations": { "type": "array", "items": { "$ref": "#/$defs/implementation" } },
        "target_bindings": { "type": "array", "items": { "$ref": "#/$defs/target_binding" } },
        "manifest": { "type": "string", "pattern": "^catalog/detections/MSEC-DET-[0-9]{4}/manifest\\.json$" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "created", "modified", "review_interval_days"],
      "properties": {
        "status": { "enum": ["draft", "experimental", "stable", "deprecated"] },
        "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "modified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "review_interval_days": { "type": "integer", "minimum": 30 }
      }
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technique_id", "tactic"],
      "properties": {
        "technique_id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
        "tactic": { "type": "string", "minLength": 3 }
      }
    },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "required_fields"],
      "properties": {
        "name": { "type": "string", "minLength": 3 },
        "category": { "type": "string", "minLength": 3 },
        "required_fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_cases", "negative_cases"],
      "properties": {
        "positive_cases": { "type": "integer", "minimum": 0 },
        "negative_cases": { "type": "integer", "minimum": 0 }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "targets", "status"],
      "properties": {
        "type": { "enum": ["sigma", "native"] },
        "path": { "type": "string", "pattern": "^(content/portable/sigma|content/native)/[^\\s]+$" },
        "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
        "status": { "enum": ["planned", "active"] }
      }
    },
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "table", "golden"],
      "properties": {
        "target": { "const": "microsoft-sentinel" },
        "table": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "golden": { "type": "string", "pattern": "^tests/golden/sentinel/MSEC-DET-[0-9]{4}\\.kql$" }
      }
    }
  }
}

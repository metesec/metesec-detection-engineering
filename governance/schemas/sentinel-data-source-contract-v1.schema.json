{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metesec.com/schemas/sentinel-data-source-contract-v1.schema.json",
  "title": "MeteSec Microsoft Sentinel data-source contract v1",
  "description": "Required table columns, types, consumers, and freshness expectations for the bounded Sentinel target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "target": { "const": "microsoft-sentinel" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^P(?=.+)(?:[0-9]+D)?(?:T(?=.+)(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?)?$"
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "type": {
          "enum": ["bool", "datetime", "dynamic", "guid", "int", "long", "real", "string", "timespan"]
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["degraded_after", "unavailable_after"],
      "properties": {
        "degraded_after": { "$ref": "#/$defs/duration" },
        "unavailable_after": { "$ref": "#/$defs/duration" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "table",
        "display_name",
        "consumers",
        "event_time_column",
        "required_columns",
        "freshness"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^MSEC-SDS-[0-9]{4}$" },
        "table": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "display_name": { "type": "string", "minLength": 1 },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^MSEC-DET-[0-9]{4}$" }
        },
        "event_time_column": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "required_columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        },
        "freshness": { "$ref": "#/$defs/freshness" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metesec.com/schemas/detection-lifecycle-assessment-v1.schema.json",
  "title": "MeteSec detection lifecycle assessment v1",
  "description": "Machine-readable, runtime-only review-cadence assessment for logical detections.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "baseline_checked", "summary", "detections"],
  "properties": {
    "schema_version": { "const": 1 },
    "as_of": { "$ref": "#/$defs/date" },
    "baseline_checked": { "type": "boolean" },
    "summary": { "$ref": "#/$defs/summary" },
    "detections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/detection" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detections", "current", "due", "overdue", "next_review_due"],
      "properties": {
        "detections": { "type": "integer", "minimum": 1 },
        "current": { "type": "integer", "minimum": 0 },
        "due": { "type": "integer", "minimum": 0 },
        "overdue": { "type": "integer", "minimum": 0 },
        "next_review_due": { "$ref": "#/$defs/date" }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "modified",
        "review_interval_days",
        "review_due",
        "review_state",
        "days_until_due"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^MSEC-DET-[0-9]{4}$" },
        "title": { "type": "string", "minLength": 8 },
        "status": { "enum": ["draft", "experimental", "stable", "deprecated"] },
        "modified": { "$ref": "#/$defs/date" },
        "review_interval_days": { "type": "integer", "minimum": 30, "maximum": 730 },
        "review_due": { "$ref": "#/$defs/date" },
        "review_state": { "enum": ["current", "due", "overdue"] },
        "days_until_due": { "type": "integer" }
      }
    }
  }
}

{
  "schema_version": 2,
  "target": "microsoft-sentinel",
  "backend": "kusto",
  "pipeline": "azure_monitor",
  "detections": [
    {
      "id": "MSEC-DET-0002",
      "implementation": "content/portable/sigma/MSEC-DET-0002/rule.yml",
      "query_table": "SigninLogs",
      "golden": "tests/golden/sentinel/MSEC-DET-0002.kql",
      "output": {
        "extend": [
          {"column": "AccountName", "expression": "tostring(split(UserPrincipalName, \"@\")[0])"},
          {"column": "AccountUPNSuffix", "expression": "tostring(split(UserPrincipalName, \"@\")[1])"},
          {"column": "SourceIPAddress", "expression": "tostring(IPAddress)"},
          {"column": "ApplicationId", "expression": "tostring(AppId)"},
          {"column": "ApplicationName", "expression": "tostring(AppDisplayName)"}
        ],
        "columns": [
          "TimeGenerated",
          "UserPrincipalName",
          "AccountName",
          "AccountUPNSuffix",
          "UserId",
          "SourceIPAddress",
          "ApplicationId",
          "ApplicationName",
          "ClientAppUsed",
          "AuthenticationRequirement",
          "ConditionalAccessStatus",
          "CorrelationId"
        ],
        "entity_mappings": [
          {
            "entity_type": "Account",
            "field_mappings": [
              {"identifier": "Name", "column": "AccountName"},
              {"identifier": "UPNSuffix", "column": "AccountUPNSuffix"},
              {"identifier": "AadUserId", "column": "UserId"}
            ]
          },
          {
            "entity_type": "IP",
            "field_mappings": [
              {"identifier": "Address", "column": "SourceIPAddress"}
            ]
          },
          {
            "entity_type": "CloudApplication",
            "field_mappings": [
              {"identifier": "AppId", "column": "ApplicationId"},
              {"identifier": "Name", "column": "ApplicationName"}
            ]
          }
        ]
      }
    },

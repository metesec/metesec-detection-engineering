{
  "name": "metesec-detection-engineering",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "description": "Validation tooling for MeteSec Detection Engineering contracts",
  "scripts": {
    "setup:sigma": "python -m pip install --requirement requirements-sigma.lock",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "test:package-contract": "node --test tests/package-contract.test.mjs",
    "validate:packages": "node scripts/validate-packages.mjs",
    "build:catalogue": "node scripts/generate-catalogue.mjs",
    "test:catalogue": "node --test tests/catalogue-generator.test.mjs",
    "validate:catalogue": "node scripts/generate-catalogue.mjs --check",
    "test:forgejo-workflow": "python -m unittest tests.test_forgejo_workflow",
    "test:sigma-validation": "python -m unittest tests.test_sigma_validation",
    "validate:sigma": "python scripts/validate_sigma.py",
    "test:sigma-evaluator": "python -m unittest tests.test_sigma_fixture_evaluator",
    "test:sigma-fixtures": "python scripts/test_sigma_fixtures.py",
    "test:sentinel-compiler": "python -m unittest tests.test_sentinel_compiler",
    "validate:sentinel-golden": "python scripts/compile_sentinel.py --check",
    "compile:sentinel": "python scripts/compile_sentinel.py",
    "validate:sentinel-profile": "node scripts/validate-sentinel-profile.mjs",
    "validate:sentinel-data-source-contract": "node scripts/validate-sentinel-data-sources.mjs",
    "test:sentinel-data-source-health": "python -m unittest tests.test_sentinel_data_source_health",
    "validate:sentinel-data-sources": "python scripts/check_sentinel_data_sources.py",
    "build:coverage": "node scripts/generate-coverage.mjs",
    "test:coverage": "node --test tests/coverage-generator.test.mjs",
    "validate:coverage": "node scripts/generate-coverage.mjs --check",
    "validate:lifecycle-policy": "node scripts/validate-lifecycle-policy.mjs",
    "test:lifecycle-contract": "node --test tests/lifecycle-contract.test.mjs",
    "test:lifecycle": "python -m unittest tests.test_detection_lifecycle",
    "validate:lifecycle": "python scripts/check_detection_lifecycle.py",
    "test:sentinel-renderer": "python -m unittest tests.test_sentinel_rule_renderer",
    "validate:sentinel-rules": "python scripts/render_sentinel_rules.py --check",
    "render:sentinel": "python scripts/render_sentinel_rules.py",
    "test:release": "python -m unittest tests.test_release_builder",
    "build:release": "python scripts/build_release.py",
    "check": "pnpm run validate:manifests && pnpm run test:package-contract && pnpm run validate:packages && pnpm run test:catalogue && pnpm run validate:catalogue && pnpm run test:forgejo-workflow && pnpm run test:sigma-validation && pnpm run validate:sigma && pnpm run test:sigma-evaluator && pnpm run test:sigma-fixtures && pnpm run test:sentinel-compiler && pnpm run validate:sentinel-golden && pnpm run validate:sentinel-profile && pnpm run test:sentinel-renderer && pnpm run validate:sentinel-rules && pnpm run validate:sentinel-data-source-contract && pnpm run test:sentinel-data-source-health && pnpm run validate:sentinel-data-sources && pnpm run test:coverage && pnpm run validate:coverage && pnpm run validate:lifecycle-policy && pnpm run test:lifecycle-contract && pnpm run test:lifecycle && pnpm run validate:lifecycle && pnpm run test:release"
  },
  "devDependencies": {
    "ajv": "8.17.1"
  },
  "engines": {
    "node": ">=20"
  }
}

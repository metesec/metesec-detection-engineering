DeviceRegistryEvents
| where ActionType =~ "RegistryValueSet" and (RegistryKey endswith "\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon" or RegistryKey endswith "\\Software\\Wow6432Node\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon") and ((RegistryValueName =~ "Shell" and (not((RegistryValueName =~ "Shell" and (RegistryValueData in~ ("explorer.exe", "C:\\Windows\\explorer.exe", "%SystemRoot%\\explorer.exe")))))) or (RegistryValueName =~ "Userinit" and (not((RegistryValueName =~ "Userinit" and (RegistryValueData in~ ("userinit.exe", "userinit.exe,", "C:\\Windows\\system32\\userinit.exe", "C:\\Windows\\system32\\userinit.exe,", "%SystemRoot%\\system32\\userinit.exe", "%SystemRoot%\\system32\\userinit.exe,")))))))
| project TimeGenerated, Timestamp, DeviceId, DeviceName, ActionType, InitiatingProcessAccountDomain, InitiatingProcessAccountName, InitiatingProcessAccountSid, InitiatingProcessFileName, InitiatingProcessCommandLine, RegistryKey, RegistryValueName, RegistryValueData, ReportId

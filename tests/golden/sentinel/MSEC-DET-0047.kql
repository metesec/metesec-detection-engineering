DeviceRegistryEvents
| where ActionType =~ "RegistryValueSet" and (RegistryKey endswith "\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon" or RegistryKey endswith "\\Software\\Wow6432Node\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon") and RegistryValueData matches regex "\\S" and ((RegistryValueName =~ "Shell" and (not((RegistryValueName =~ "Shell" and RegistryValueData matches regex "(?i)^\\s*\"?(?:(?:[a-z]:\\\\Windows|%SystemRoot%|%windir%)\\\\)?explorer\\.exe\"?\\s*$")))) or (RegistryValueName =~ "Userinit" and (not((RegistryValueName =~ "Userinit" and RegistryValueData matches regex "(?i)^\\s*\"?(?:(?:[a-z]:\\\\Windows|%SystemRoot%|%windir%)\\\\system32\\\\)?userinit\\.exe\"?\\s*,?\\s*$")))))
| project TimeGenerated, Timestamp, DeviceId, DeviceName, ActionType, InitiatingProcessAccountDomain, InitiatingProcessAccountName, InitiatingProcessAccountSid, InitiatingProcessFileName, InitiatingProcessCommandLine, RegistryKey, RegistryValueName, RegistryValueData, ReportId

DeviceProcessEvents
| where (FileName in~ ("powershell.exe", "pwsh.exe")) and (ProcessCommandLine matches regex "(?i)\\.Download(?:String|File)\\s*\\(" or ProcessCommandLine matches regex "(?i)(?:^|[\\s;|(\"])(?:Invoke-WebRequest|Invoke-RestMethod|iwr|irm)(?:\\s|\\()") and ProcessCommandLine matches regex "(?i)(?:^|[\\s;|(\"])(?:iex|Invoke-Expression)(?:\\s|\\(|$|\")"
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

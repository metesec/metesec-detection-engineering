DeviceProcessEvents
| where (FileName =~ "wmic.exe" and ProcessCommandLine matches regex "(?i)\\s/node:\\s*\\S" and ProcessCommandLine matches regex "(?i)\\s(?:process|path\\s+Win32_Process)\\s+call\\s+create(?:\\s|$)") or ((FileName in~ ("powershell.exe", "pwsh.exe")) and ProcessCommandLine matches regex "(?i)(?:^|[\\s\";{&])Invoke-(?:Wmi|Cim)Method(?:\\s|$)" and ProcessCommandLine matches regex "(?i)(?:^|[\\s\"'])Win32_Process(?:[\\s\"']|$)" and ProcessCommandLine matches regex "(?i)\\s-(?:Name|MethodName)\\s+[\"']?Create(?:[\\s\"']|$)" and ProcessCommandLine matches regex "(?i)\\s-(?:ComputerName|CimSession)(?:\\s+|:)\\S")
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

DeviceRegistryEvents
| where (ActionType =~ "RegistryValueSet" and RegistryKey matches regex "(?i)^HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\(?:WOW6432Node\\\\)?Microsoft\\\\Windows NT\\\\CurrentVersion\\\\SilentProcessExit\\\\[^\\\\]+$" and RegistryValueName =~ "MonitorProcess") and (RegistryValueData matches regex "(?i)^\\s*(?:\"(?:[^\"\\r\\n]*\\\\)?(?:cmd|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript)\\.exe\"|(?:[^\\s\"\\r\\n]*\\\\)?(?:cmd|powershell|pwsh|mshta|rundll32|regsvr32|wscript|cscript)\\.exe)(?:\\s|$)" or RegistryValueData matches regex "(?i)^\\s*\"?(?:[a-z]:\\\\(?:users\\\\|windows\\\\temp\\\\|temp\\\\|perflogs\\\\|\\$recycle\\.bin\\\\)|%(?:temp|tmp|appdata|localappdata|userprofile)%\\\\|\\\\\\\\[a-z0-9_-][^\\\\/:*?\"<>|\\r\\n]*\\\\[^\\\\/:*?\"<>|\\r\\n]+\\\\)")
| project TimeGenerated, Timestamp, DeviceId, DeviceName, ActionType, InitiatingProcessAccountDomain, InitiatingProcessAccountName, InitiatingProcessAccountSid, InitiatingProcessFileName, InitiatingProcessCommandLine, RegistryKey, RegistryValueName, RegistryValueData, ReportId

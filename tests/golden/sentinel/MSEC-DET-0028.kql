DeviceProcessEvents
| where (FileName =~ "schtasks.exe" or ProcessVersionInfoOriginalFileName =~ "schtasks.exe") and ProcessCommandLine matches regex "(?i)(?:^|\\s)/create(?:\\s|$)" and ProcessCommandLine matches regex "(?i)^\\s*(?:\"[^\"]*\"|[^\\s\"]+)(?:\\s+(?:\"[^\"]*\"|[^\\s\"]+))*\\s+/s\\s+(?:\"[^\"]+\"|[^\\s\"]+)"
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

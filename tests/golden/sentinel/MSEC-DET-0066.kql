AzureActivity
| where CategoryValue =~ "Administrative" and OperationNameValue =~ "Microsoft.KeyVault/locations/deletedVaults/purge/action" and (ActivityStatusValue in~ ("Succeeded", "Success"))
| project TimeGenerated, OperationNameValue, ActivityStatusValue, CategoryValue, Caller, CallerIpAddress, CorrelationId, EventDataId, ResourceId, SubscriptionId

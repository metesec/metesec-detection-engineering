DeviceProcessEvents
| where (FileName =~ "ntdsutil.exe" or ProcessVersionInfoOriginalFileName =~ "ntdsutil.exe") and ProcessCommandLine matches regex "(?i)(?:^|[\\s\"])ac(?:tivate)?\\s+i(?:nstance)?\\s+ntds(?:[\\s\"]|$)" and ProcessCommandLine matches regex "(?i)(?:^|[\\s\"])ifm(?:[\\s\"]|$)" and ProcessCommandLine matches regex "(?i)(?:^|[\\s\"])create\\s+(?:full|rodc|sysvol)(?:[\\s\"]|$)"
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

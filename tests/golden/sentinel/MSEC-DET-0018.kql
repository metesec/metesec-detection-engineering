DeviceProcessEvents
| where (FileName in~ ("powershell.exe", "pwsh.exe")) and (ProcessCommandLine matches regex "(?i)(?:^|[\\s\";{&])Set-MpPreference\\s+[^;|\\r\\n]*-Disable(?:RealtimeMonitoring|BehaviorMonitoring|ScriptScanning|IOAVProtection)(?:\\s+|:\\s*)(?:\\$true|1)(?:\\s|[;\"})]|$)" or ProcessCommandLine matches regex "(?i)(?:^|[\\s\";{&])(?:Set|Add)-MpPreference\\s+[^;|\\r\\n]*-Exclusion(?:Path|Process|Extension)(?:\\s+|:\\s*)(?:\"[^\"\\r\\n]+\"|'[^'\\r\\n]+'|[a-z0-9*?.\\\\][^\\s;|]*)")
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

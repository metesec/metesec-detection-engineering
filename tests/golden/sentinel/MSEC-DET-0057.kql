DeviceNetworkEvents
| where ActionType =~ "ConnectionSuccess" and RemoteIPType =~ "Public" and (InitiatingProcessFileName in~ ("svchost.exe", "services.exe", "lsass.exe", "winlogon.exe", "csrss.exe", "smss.exe", "spoolsv.exe", "taskhostw.exe", "dllhost.exe", "conhost.exe")) and InitiatingProcessFolderPath matches regex "(?i)^(?:[a-z]:\\\\(?:users|windows\\\\temp|temp|perflogs|\\$recycle\\.bin)(?:\\\\|$)|\\\\\\\\[a-z0-9_-][^\\\\/:*?\"<>|\\r\\n]*\\\\[^\\\\/:*?\"<>|\\r\\n]+(?:\\\\|$))"
| project TimeGenerated, DeviceId, DeviceName, ActionType, RemoteIP, RemoteIPType, RemotePort, InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessCommandLine, ReportId

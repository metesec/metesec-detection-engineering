DeviceProcessEvents
| where (FileName =~ "netsh.exe" and ProcessCommandLine matches regex "(?i)(?:^|\\s)advfirewall\\s+set\\s+(?:allprofiles|currentprofile|domainprofile|privateprofile|publicprofile)\\s+state\\s+off(?:\\s|$)") or ((FileName in~ ("powershell.exe", "pwsh.exe")) and ProcessCommandLine matches regex "(?i)(?:^|[\\s;&|{\"'])Set-NetFirewallProfile(?:\\s|$)" and ProcessCommandLine matches regex "(?i)(?:^|\\s)-Enabled(?:\\s+|:\\s*)['\"]?\\$?false['\"]?(?:[\\s;}\"']|$)")
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

DeviceProcessEvents
| where (FileName =~ "wevtutil.exe" and ProcessCommandLine matches regex "(?i)\\s(?:cl|clear-log)\\s+\\S") or ((FileName in~ ("powershell.exe", "pwsh.exe")) and ProcessCommandLine matches regex "(?i)(?:^|[\\s\";{&])Clear-EventLog\\s+(?:-LogName\\s+)?[\\w\"'*]")
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

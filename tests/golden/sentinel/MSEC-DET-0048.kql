DeviceProcessEvents
| where (FileName =~ "schtasks.exe" or ProcessVersionInfoOriginalFileName =~ "schtasks.exe") and ProcessCommandLine matches regex "(?i)(?:^|\\s)/create(?:\\s|$)" and (not(ProcessCommandLine matches regex "(?i)^\\s*(?:\"[^\"]*\"|[^\\s\"]+)(?:\\s+(?:\"[^\"]*\"|[^\\s\"]+))*\\s+/s\\s+(?:\"[^\"]+\"|[^\\s\"]+)")) and ((ProcessCommandLine matches regex "(?i)(?:^|\\s)/tr\\s+\"[^\"\\r\\n]*(?:\\\\AppData\\\\|\\\\Users\\\\Public\\\\|\\\\Temp\\\\|%APPDATA%|%LOCALAPPDATA%|%TEMP%)[^\"\\r\\n]*\\.(?:exe|com|scr|dll|ps1|vbs|vbe|js|jse|wsf|hta|bat|cmd)(?:[\"\\s]|$)" or ProcessCommandLine matches regex "(?i)(?:^|\\s)/tr\\s+[^\\s\"]*(?:\\\\AppData\\\\|\\\\Users\\\\Public\\\\|\\\\Temp\\\\|%APPDATA%|%LOCALAPPDATA%|%TEMP%)[^\\s\"]*\\.(?:exe|com|scr|dll|ps1|vbs|vbe|js|jse|wsf|hta|bat|cmd)(?:\\s|$)") or ProcessCommandLine matches regex "(?i)(?:^|\\s)/tr\\s+\"[^\"\\r\\n]*\\b(?:powershell|pwsh)(?:\\.exe)?\\b[^\"\\r\\n]*(?:\\s-(?:enc|encodedcommand)(?:\\s|:)|downloadstring|downloadfile|invoke-webrequest|invoke-restmethod|invoke-expression|\\biex\\s*\\(|-\\w*windowstyle\\s+hidden|\\s-w\\s+hidden)" or ProcessCommandLine matches regex "(?i)(?:^|\\s)/tr\\s+\"[^\"\\r\\n]*\\b(?:mshta|regsvr32|rundll32)(?:\\.exe)?\\b[^\"\\r\\n]*(?:https?://|javascript:|vbscript:|scrobj\\.dll|mshtml)")
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

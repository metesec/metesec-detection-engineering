DeviceProcessEvents
| where (FileName =~ "schtasks.exe" or ProcessVersionInfoOriginalFileName =~ "schtasks.exe") and ProcessCommandLine contains "/create" and ProcessCommandLine contains "/tr" and (not(ProcessCommandLine contains " /s ")) and (((ProcessCommandLine contains "\\AppData\\" or ProcessCommandLine contains "\\Users\\Public\\" or ProcessCommandLine contains "\\Windows\\Temp\\" or ProcessCommandLine contains "\\Temp\\" or ProcessCommandLine contains "%APPDATA%" or ProcessCommandLine contains "%LOCALAPPDATA%" or ProcessCommandLine contains "%TEMP%") and (ProcessCommandLine contains ".exe" or ProcessCommandLine contains ".com" or ProcessCommandLine contains ".scr" or ProcessCommandLine contains ".dll" or ProcessCommandLine contains ".ps1" or ProcessCommandLine contains ".vbs" or ProcessCommandLine contains ".vbe" or ProcessCommandLine contains ".js" or ProcessCommandLine contains ".jse" or ProcessCommandLine contains ".wsf" or ProcessCommandLine contains ".hta" or ProcessCommandLine contains ".bat" or ProcessCommandLine contains ".cmd")) or ((ProcessCommandLine contains "powershell" or ProcessCommandLine contains "pwsh") and (ProcessCommandLine contains " -enc " or ProcessCommandLine contains " -enc:" or ProcessCommandLine contains " -encodedcommand " or ProcessCommandLine contains " -encodedcommand:" or ProcessCommandLine contains "downloadstring" or ProcessCommandLine contains "downloadfile" or ProcessCommandLine contains "invoke-webrequest" or ProcessCommandLine contains "invoke-restmethod" or ProcessCommandLine contains "invoke-expression" or ProcessCommandLine contains "iex(" or ProcessCommandLine contains "|iex" or ProcessCommandLine contains "-windowstyle hidden" or ProcessCommandLine contains "-w hidden")) or ((ProcessCommandLine contains "mshta" or ProcessCommandLine contains "regsvr32" or ProcessCommandLine contains "rundll32") and (ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://" or ProcessCommandLine contains "javascript:" or ProcessCommandLine contains "vbscript:" or ProcessCommandLine contains "scrobj.dll" or ProcessCommandLine contains "mshtml")))
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

DeviceProcessEvents
| where ((FileName in~ ("net.exe", "net1.exe")) and ProcessCommandLine matches regex "(?i)(?:^|\\s)localgroup\\s+\"?(?:Administrators|Administratoren)\"?\\s+(?:\"[^\"]+\"|[^/\\s]\\S*)" and ProcessCommandLine matches regex "(?i)(?:^|\\s)/add(?:\\s|$)" and (not(ProcessCommandLine matches regex "(?i)(?:^|\\s)/domain(?:\\s|$)"))) or ((FileName in~ ("powershell.exe", "pwsh.exe")) and ProcessCommandLine matches regex "(?i)(?:^|[\\s;&|{\"'])Add-LocalGroupMember(?:\\s|$)" and (ProcessCommandLine matches regex "(?i)(?:^|\\s)-Group(?:\\s+|:\\s*)['\"]?(?:Administrators|Administratoren)['\"]?(?:\\s|$)" or ProcessCommandLine matches regex "(?i)(?:^|\\s)-SID(?:\\s+|:\\s*)['\"]?S-1-5-32-544['\"]?(?:\\s|$)" or ProcessCommandLine matches regex "(?i)(?:^|[\\s;&|{\"'])Add-LocalGroupMember\\s+['\"]?(?:Administrators|Administratoren)['\"]?(?:\\s|$)") and (ProcessCommandLine matches regex "(?i)(?:^|\\s)-Member(?:\\s+|:\\s*)\\S+" or ProcessCommandLine matches regex "(?i)(?:^|[\\s;&|{\"'])Add-LocalGroupMember\\s+['\"]?(?:Administrators|Administratoren)['\"]?\\s+[^\\s-]\\S*"))
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

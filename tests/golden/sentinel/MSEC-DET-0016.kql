DeviceProcessEvents
| where (FileName =~ "vssadmin.exe" and ProcessCommandLine matches regex "(?i)\\sdelete\\s+shadows(?:\\s|$)") or (FileName =~ "wmic.exe" and ProcessCommandLine matches regex "(?i)\\sshadowcopy(?:\\s+[^\\r\\n]*)?\\sdelete(?:\\s|$)") or (FileName =~ "wbadmin.exe" and ProcessCommandLine matches regex "(?i)\\sdelete\\s+(?:catalog|systemstatebackup)(?:\\s|$)") or (FileName =~ "bcdedit.exe" and (ProcessCommandLine matches regex "(?i)\\s/set\\s+(?:\\{[^}]+\\}\\s+)?recoveryenabled\\s+(?:no|off|0)(?:\\s|$)" or ProcessCommandLine matches regex "(?i)\\s/set\\s+(?:\\{[^}]+\\}\\s+)?bootstatuspolicy\\s+ignoreallfailures(?:\\s|$)")) or (FileName =~ "reagentc.exe" and ProcessCommandLine matches regex "(?i)\\s/disable(?:\\s|$)")
| project TimeGenerated, Timestamp, DeviceId, DeviceName, AccountDomain, AccountName, AccountSid, InitiatingProcessFileName, FileName, ProcessVersionInfoOriginalFileName, FolderPath, ProcessCommandLine, ReportId

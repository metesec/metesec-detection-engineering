DeviceRegistryEvents
| where ActionType =~ "RegistryValueSet" and RegistryValueName =~ "Path" and RegistryKey matches regex "(?i)^(?:HKEY_CURRENT_USER|HKEY_USERS\\\\S-1-5-[0-9-]+)\\\\SOFTWARE\\\\(?:Policies\\\\)?Microsoft\\\\Office\\\\16\\.0\\\\(?:Word|Excel|PowerPoint|Access|Visio|Project|Common)\\\\Security\\\\Trusted Locations\\\\Location[0-9]+$" and RegistryValueData matches regex "(?i)^(?:[a-z]:\\\\$|[a-z]:\\\\(?:users\\\\public(?:\\\\|$)|users\\\\[^\\\\]+\\\\(?:downloads|desktop|appdata\\\\local\\\\temp)(?:\\\\|$)|windows\\\\temp(?:\\\\|$)|temp(?:\\\\|$)|\\$recycle\\.bin(?:\\\\|$))|\\\\\\\\[a-z0-9_-][^\\\\/:*?\"<>|\\r\\n]*\\\\[^\\\\/:*?\"<>|\\r\\n]+(?:\\\\|$)|%(?:temp|tmp|appdata|localappdata|userprofile)%(?:\\\\|$))"
| project TimeGenerated, Timestamp, DeviceId, DeviceName, ActionType, InitiatingProcessAccountDomain, InitiatingProcessAccountName, InitiatingProcessAccountSid, InitiatingProcessFileName, InitiatingProcessCommandLine, RegistryKey, RegistryValueName, RegistryValueData, ReportId

DeviceRegistryEvents
| where RegistryValueName =~ "Debugger" and (RegistryKey endswith "\\Image File Execution Options\\sethc.exe" or RegistryKey endswith "\\Image File Execution Options\\utilman.exe" or RegistryKey endswith "\\Image File Execution Options\\osk.exe" or RegistryKey endswith "\\Image File Execution Options\\Magnify.exe" or RegistryKey endswith "\\Image File Execution Options\\Narrator.exe" or RegistryKey endswith "\\Image File Execution Options\\DisplaySwitch.exe" or RegistryKey endswith "\\Image File Execution Options\\atbroker.exe" or RegistryKey endswith "\\Image File Execution Options\\HelpPane.exe")
| project TimeGenerated, Timestamp, DeviceId, DeviceName, ActionType, InitiatingProcessAccountDomain, InitiatingProcessAccountName, InitiatingProcessAccountSid, InitiatingProcessFileName, InitiatingProcessCommandLine, RegistryKey, RegistryValueName, RegistryValueData, ReportId

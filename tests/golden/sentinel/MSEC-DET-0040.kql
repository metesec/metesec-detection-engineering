DeviceRegistryEvents
| where ActionType =~ "RegistryValueSet" and (RegistryValueName =~ "Debugger" and RegistryValueData matches regex "\\S") and RegistryKey matches regex "(?i)^(?:HKEY_LOCAL_MACHINE|HKLM)\\\\SOFTWARE\\\\(?:Wow6432Node\\\\)?Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Image File Execution Options\\\\(?:sethc|utilman|osk|Magnify|Narrator|DisplaySwitch|atbroker|HelpPane)\\.exe$"
| project TimeGenerated, Timestamp, DeviceId, DeviceName, ActionType, InitiatingProcessAccountDomain, InitiatingProcessAccountName, InitiatingProcessAccountSid, InitiatingProcessFileName, InitiatingProcessCommandLine, RegistryKey, RegistryValueName, RegistryValueData, ReportId
